+      otherWorkPageForActor(
+        actor,
+        { view: "chaseToday", teamId: "other" } as never,
+        repo,
+        "2026-10-23",
+      ),
+    ).rejects.toThrow();
+    expect(repo.list).not.toHaveBeenCalled();
+  });
+  it("propagates a failed read instead of reporting empty work", async () => {
+    const repo = {
+      list: vi.fn(async () => {
+        throw new Error("read unavailable");
+      }),
+    };
+    await expect(
+      otherWorkPageForActor(actor, { view: "chaseToday" }, repo, "2026-10-23"),
+    ).rejects.toThrow("read unavailable");
+  });
+});
diff --git a/src/features/annual-return/work-views-other-page.ts b/src/features/annual-return/work-views-other-page.ts
new file mode 100644
index 0000000..682a4e1
--- /dev/null
+++ b/src/features/annual-return/work-views-other-page.ts
@@ -0,0 +1,119 @@
+import type { AuthenticatedActor } from "@/features/auth/types";
+import { z } from "zod";
+import {
+  incorporationReadScope,
+  type IncorporationReadScope,
+} from "@/features/incorporation/authorization";
+import { corporateChangeListTeamScope } from "@/features/corporate-changes/read";
+import { otherWorkRow, type OtherWorkSource, type OtherWorkRow } from "./work-views-other";
+
+export const otherWorkPageInput = z
+  .object({
+    view: z.enum([
+      "chaseToday",
+      "newlyReceived",
+      "awaitingMyReview",
+      "readyToFile",
+      "returnsAndExceptions",
+    ]),
+    q: z.string().trim().max(200).optional(),
+    sort: z.enum(["deadline", "company"]).optional(),
+    cursor: z.string().max(4096).optional(),
+    limit: z.number().int().min(1).max(100).optional(),
+  })
+  .strict();
+
+export type OtherWorkReadQuery = {
+  incorporationScope: IncorporationReadScope;
+  corporateTeamId: string | undefined;
+  viewerUserId: string;
+  view: z.infer<typeof otherWorkPageInput>["view"];
+  q: string;
+  sort: "deadline" | "company";
+  after: { sortKey: string; business: OtherWorkSource["business"]; id: string } | null;
+  today: string;
+  limit: number;
+};
+export type OtherWorkPageRepository = {
+  list(input: OtherWorkReadQuery): Promise<(OtherWorkSource & { sortKey: string })[]>;
+};
+export type OtherWorkPage = { rows: OtherWorkRow[]; nextCursor: string | null };
+
+/** Both domain scopes are checked before the caller may open a repository. */
+export function otherWorkScope(actor: AuthenticatedActor) {
+  const incorporationScope = incorporationReadScope(actor);
+  if (!actor.userId) throw new Error("Forbidden: a staff database identity is required.");
+  return {
+    incorporationScope,
+    corporateTeamId: corporateChangeListTeamScope(actor),
+    viewerUserId: actor.userId,
+  };
+}
+
+export async function otherWorkPageForActor(
+  actor: AuthenticatedActor,
+  input: unknown,
+  repository: OtherWorkPageRepository,
+  today: string,
+): Promise<OtherWorkPage> {
+  const scope = otherWorkScope(actor),
+    data = otherWorkPageInput.parse(input);
+  const q = data.q ?? "",
+    sort = data.sort ?? "deadline",
+    limit = data.limit ?? 25;
+  const context = JSON.stringify([
+    actor.authUserId,
+    actor.userId,
+    actor.role,
+    actor.teamId,
+    data.view,
+    q,
+    sort,
+    today,
+  ]);
+  let after: OtherWorkReadQuery["after"] = null;
+  if (data.cursor) {
+    try {
+      const cursor = z
+        .object({
+          context: z.literal(context),
+          sortKey: z.string().max(1000),
+          business: z.enum(["incorporation", "corporate_change"]),
+          id: z.string().uuid(),
+        })
+        .strict()
+        .parse(JSON.parse(Buffer.from(data.cursor, "base64url").toString()));
+      after = { sortKey: cursor.sortKey, business: cursor.business, id: cursor.id };
+    } catch {
+      throw new Error("Invalid Today cursor; reset pagination explicitly.");
+    }
+  }
+  const sources = await repository.list({
+    ...scope,
+    view: data.view,
+    q,
+    sort,
+    after,
+    today,
+    limit: limit + 1,
+  });
+  const selected = sources.slice(0, limit),
+    last = selected.at(-1);
+  return {
+    rows: selected.flatMap((source) => {
+      const row = otherWorkRow(source, today);
+      return row ? [row] : [];
+    }),
+    nextCursor:
+      sources.length > limit && last
+        ? Buffer.from(
+            JSON.stringify({
+              context,
+              sortKey: last.sortKey,
+              business: last.business,
+              id: last.id,
+            }),
+          ).toString("base64url")
+        : null,
+  };
+}
diff --git a/src/features/annual-return/work-views-other-repository.ts b/src/features/annual-return/work-views-other-repository.ts
new file mode 100644
index 0000000..1943aef
--- /dev/null
+++ b/src/features/annual-return/work-views-other-repository.ts
@@ -0,0 +1,112 @@
+import type { SqlClient } from "@/server/db/client";
+import { operationalRead } from "@/server/db/operational-read";
+import type { OtherWorkPageRepository } from "./work-views-other-page";
+import type { OtherWorkSource } from "./work-views-other";
+
+type Row = {
+  business: OtherWorkSource["business"];
+  id: string;
+  company_name: string;
+  owner_id: string | null;
+  owner_name: string | null;
+  reviewer_id: string | null;
+  reviewer_name: string | null;
+  due_date: string | null;
+  status: string;
+  status_at: string | Date | null;
+  required_count: number;
+  missing_labels: string[];
+  received_count: number;
+  sort_key: string;
+};
+
+/** SELECT-only projection. Each case domain remains the sole owner of its writes. */
+export function createOtherWorkReadRepository(client: SqlClient): OtherWorkPageRepository {
+  return {
+    async list(input) {
+      const pattern = input.q ? `%${input.q.replace(/[\\%_]/g, (value) => `\\${value}`)}%` : null;
+      return operationalRead(client, async (sql) => {
+        const rows = await sql<Row[]>`
+          with sources as (
+            select 'incorporation'::text business, ic.id,
+              coalesce(nullif(ic.proposed_company_name_zh,''),ic.proposed_company_name_en) company_name,
+              ic.proposed_company_name_en||' '||coalesce(ic.proposed_company_name_zh,'') search_name,
+              ic.owner_id, owner.name owner_name, null::uuid reviewer_id, null::text reviewer_name,
+              ic.target_completion_date::text due_date, ic.status,
+              greatest(ic.updated_at,ci.updated_at) status_at,
+              ci.required_count,ci.missing_labels,ci.received_count,ci.rejected_count
+            from incorporation_cases ic left join users owner on owner.id=ic.owner_id
+            cross join lateral (
+              select count(*) filter(where required)::int required_count,
+                coalesce(array_agg(item_label order by id) filter(where required and status in ('Missing','Rejected')),array[]::text[]) missing_labels,
+                count(*) filter(where status='Received')::int received_count,
+                count(*) filter(where status='Rejected')::int rejected_count,max(updated_at) updated_at
+              from incorporation_checklist_items where case_id=ic.id
+            ) ci
+            where (${input.incorporationScope.kind === "all"} or ic.team_id=${input.incorporationScope.teamId ?? null}::uuid)
+              and ic.status<>'Completed' and ic.completed_at is null
+            union all
+            select 'corporate_change',r.id,c.company_name,c.company_name,
+              r.owner_id,owner.name,w.reviewer_id,w.reviewer_name,
+              to_char(w.sla_due_at at time zone 'Asia/Hong_Kong','YYYY-MM-DD'),r.status,
+              greatest(r.updated_at,ci.updated_at,w.updated_at),ci.required_count,ci.missing_labels,ci.received_count,ci.rejected_count
+            from corporate_change_requests r join companies c on c.id=r.company_id
+            left join users owner on owner.id=r.owner_id
+            left join lateral (
+              select wi.reviewer_id,reviewer.name reviewer_name,wi.sla_due_at,wi.updated_at
+              from work_items wi left join users reviewer on reviewer.id=wi.reviewer_id
+              where wi.corporate_change_request_id=r.id and wi.company_id=r.company_id
+                and wi.status not in ('completed','cancelled')
+              order by wi.sla_due_at asc nulls last,wi.id limit 1
+            ) w on true
+            cross join lateral (
+              select count(*) filter(where required)::int required_count,
+                coalesce(array_agg(item_label order by id) filter(where required and status in ('Missing','Rejected')),array[]::text[]) missing_labels,
+                count(*) filter(where status='Received')::int received_count,
+                count(*) filter(where status='Rejected')::int rejected_count,max(updated_at) updated_at
+              from corporate_change_checklist_items where request_id=r.id
+            ) ci
+            where (${input.corporateTeamId ?? null}::uuid is null or c.assigned_team_id=${input.corporateTeamId ?? null}::uuid)
+              and r.status not in ('Completed','Cancelled') and r.completed_at is null
+          ), filtered as (
+            select *,case when ${input.sort}='company' then company_name else coalesce(due_date,'9999-12-31') end sort_key
+            from sources where (${pattern}::text is null or search_name ilike ${pattern} escape '\\')
+              and case ${input.view}
+                when 'chaseToday' then status<>'Filed with Registrar'
+                  and (cardinality(missing_labels)>0 or required_count=0 or status in ('Intake','Requested'))
+                  and (due_date is null or due_date::date<=${input.today}::date+30)
+                when 'newlyReceived' then status<>'Filed with Registrar' and received_count>0
+                when 'awaitingMyReview' then status<>'Filed with Registrar'
+                  and (owner_id=${input.viewerUserId}::uuid or reviewer_id=${input.viewerUserId}::uuid)
+                  and (received_count>0 or status='Ready to file')
+                when 'returnsAndExceptions' then status='Filed with Registrar' or rejected_count>0
+                  or (status='Documents pending' and required_count>0
+                    and cardinality(missing_labels)=0 and received_count=0)
+                else false
+              end
+          ) select * from filtered
+          where (${input.after === null} or (sort_key collate "C",business collate "C",id)>
+            (${input.after?.sortKey ?? ""} collate "C",${input.after?.business ?? ""} collate "C",${input.after?.id ?? null}::uuid))
+          order by sort_key collate "C",business collate "C",id limit ${input.limit}
+        `;
+        return rows.map((r) => ({
+          business: r.business,
+          id: r.id,
+          companyName: r.company_name,
+          ownerId: r.owner_id,
+          ownerName: r.owner_name,
+          reviewerId: r.reviewer_id,
+          reviewerName: r.reviewer_name,
+          dueDate: r.due_date,
+          status: r.status,
+          statusAt: r.status_at instanceof Date ? r.status_at.toISOString() : r.status_at,
+          completedAt: null,
+          requiredCount: r.required_count,
+          missingLabels: r.missing_labels,
+          receivedCount: r.received_count,
+          sortKey: r.sort_key,
+        }));
+      });
+    },
+  };
+}
diff --git a/src/features/annual-return/work-views-other-server.ts b/src/features/annual-return/work-views-other-server.ts
new file mode 100644
index 0000000..8dba289
--- /dev/null
+++ b/src/features/annual-return/work-views-other-server.ts
@@ -0,0 +1,25 @@
+import { createServerFn } from "@tanstack/react-start";
+import { otherWorkPageForActor, otherWorkPageInput, otherWorkScope } from "./work-views-other-page";
+import { toHongKongBusinessDate } from "@/lib/hong-kong-time";
+
+export const getOtherBusinessWorkPage = createServerFn({ method: "GET" })
+  .validator(otherWorkPageInput)
+  .handler(async ({ data }) => {
+    const [{ getRequest }, { requireStaffActor }] = await Promise.all([
+      import("@tanstack/react-start/server"),
+      import("@/features/auth/neon-auth-server"),
+    ]);
+    const actor = await requireStaffActor(getRequest());
+    otherWorkScope(actor);
+    // Authorization precedes importing/creating any real client. Unit tests inject a read stub.
+    const [{ getSqlClient }, { createOtherWorkReadRepository }] = await Promise.all([
+      import("@/server/db/client"),
+      import("./work-views-other-repository"),
+    ]);
+    return otherWorkPageForActor(
+      actor,
+      data,
+      createOtherWorkReadRepository(getSqlClient()),
+      toHongKongBusinessDate(new Date()),
+    );
+  });
diff --git a/src/features/annual-return/work-views-other.integration.test.ts b/src/features/annual-return/work-views-other.integration.test.ts
new file mode 100644
index 0000000..d205642
--- /dev/null
+++ b/src/features/annual-return/work-views-other.integration.test.ts
@@ -0,0 +1,163 @@
+import { randomUUID } from "node:crypto";
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { createSqlClient, type SqlClient } from "@/server/db/client";
+import { createOtherWorkReadRepository } from "./work-views-other-repository";
+import { otherWorkPageForActor } from "./work-views-other-page";
+
+// Run only by the parent after its exact disposable-target identity gate.
+const databaseUrl = process.env.TEST_DATABASE_URL;
+describe.skipIf(!databaseUrl)("Today other-business SQL read projection", () => {
+  let sql: SqlClient;
+  beforeAll(() => {
+    sql = createSqlClient(databaseUrl!);
+  });
+  afterAll(async () => {
+    await sql?.end();
+  });
+
+  it.each(["incorporation", "corporate_change"] as const)(
+    "%s remains visible for manual follow-up after its final checklist verification",
+    async (business) => {
+      const rollback = new Error("owned Today final-verification rollback");
+      let verified = false;
+      try {
+        await sql.begin(async (tx) => {
+          const prefix = `Today-final-${randomUUID()}`;
+          const teamId = randomUUID(),
+            ownerId = randomUUID(),
+            companyId = randomUUID(),
+            caseId = randomUUID();
+          await tx`insert into teams(id,name) values(${teamId},${prefix})`;
+          await tx`insert into users(id,name,email,role,team_id) values(${ownerId},'Today follow-up owner',${prefix + "@example.test"},'Staff',${teamId})`;
+          if (business === "incorporation") {
+            await tx`insert into incorporation_cases(id,proposed_company_name_en,proposed_registered_office,proposed_company_secretary,registered_capital,business_nature,status,owner_id,team_id,target_completion_date)
+              values(${caseId},${prefix},'Synthetic office','Synthetic secretary',10000,'Synthetic','Documents pending',${ownerId},${teamId},'2026-10-22')`;
+            await tx`insert into incorporation_checklist_items(case_id,item_label,required,status,received_at)
+              values(${caseId},'Final required evidence',true,'Received',now())`;
+          } else {
+            await tx`insert into companies(id,company_name,cr_number,br_number,incorporation_date,annual_return_basis_date,registered_office,company_secretary,assigned_owner_id,assigned_team_id,data_origin)
+              values(${companyId},${prefix},${prefix + "-cr"},${prefix + "-br"},'2020-01-01','2020-01-01','Synthetic office','Synthetic secretary',${ownerId},${teamId},'fixture')`;
+            await tx`insert into corporate_change_requests(id,company_id,change_type,status,owner_id,quoted_fee,new_registered_office)
+              values(${caseId},${companyId},'address_change','Documents pending',${ownerId},100,'Synthetic new office')`;
+            await tx`insert into corporate_change_checklist_items(request_id,item_label,required,status,received_at)
+              values(${caseId},'Final required evidence',true,'Received',now())`;
+          }
+          const repository = createOtherWorkReadRepository(tx as unknown as SqlClient);
+          const actor = {
+            authUserId: ownerId,
+            userId: ownerId,
+            role: "Staff" as const,
+            active: true,
+            teamId,
+          };
+          const read = (view: "newlyReceived" | "returnsAndExceptions" | "readyToFile") =>
+            otherWorkPageForActor(actor, { view, q: prefix }, repository, "2026-10-23");
+          expect((await read("newlyReceived")).rows.map((row) => row.caseId)).toEqual([caseId]);
+          if (business === "incorporation")
+            await tx`update incorporation_checklist_items set status='Verified',verified_at=now(),updated_at=now() where case_id=${caseId}`;
+          else
+            await tx`update corporate_change_checklist_items set status='Verified',verified_at=now(),updated_at=now() where request_id=${caseId}`;
+
+          const followUp = await read("returnsAndExceptions");
+          expect(followUp.rows.map((row) => row.caseId)).toEqual([caseId]);
+          expect(followUp.rows[0]).toMatchObject({
+            business,
+            status: "Documents pending",
+            readyForApproval: false,
+          });
+          expect(followUp.rows[0].blocker).toMatch(/未完成/);
+          expect(followUp.rows[0].nextStep).toMatch(/人手/);
+          expect((await read("newlyReceived")).rows).toEqual([]);
+          expect((await read("readyToFile")).rows).toEqual([]);
+          verified = true;
+          throw rollback;
+        });
+      } catch (error) {
+        if (error !== rollback) throw error;
+      }
+      expect(verified).toBe(true);
+    },
+  );
+
+  it("scopes both businesses before keyset pagination and excludes completed work", async () => {
+    const rollback = new Error("owned Today read fixture rollback");
+    let verified = false;
+    try {
+      await sql.begin(async (tx) => {
+        const prefix = `Today-${randomUUID()}`;
+        const teamA = randomUUID(),
+          teamB = randomUUID(),
+          owner = randomUUID();
+        const company = randomUUID(),
+          incA = randomUUID(),
+          incB = randomUUID(),
+          closed = randomUUID(),
+          change = randomUUID();
+        await tx`insert into teams(id,name) values(${teamA},${prefix + "-a"}),(${teamB},${prefix + "-b"})`;
+        await tx`insert into users(id,name,email,role,team_id) values(${owner},'Today synthetic owner',${prefix + "@example.test"},'Staff',${teamA})`;
+        await tx`insert into companies(id,company_name,cr_number,br_number,incorporation_date,annual_return_basis_date,registered_office,company_secretary,assigned_owner_id,assigned_team_id,data_origin)
+          values(${company},${prefix},${prefix + "-cr"},${prefix + "-br"},'2020-01-01','2020-01-01','Synthetic office','Synthetic secretary',${owner},${teamA},'fixture')`;
+        for (const [id, team, status] of [
+          [incA, teamA, "Documents pending"],
+          [incB, teamB, "Documents pending"],
+          [closed, teamA, "Completed"],
+        ]) {
+          await tx`insert into incorporation_cases(id,proposed_company_name_en,proposed_registered_office,proposed_company_secretary,registered_capital,business_nature,status,owner_id,team_id,target_completion_date,company_id,completed_at)
+            values(${id},${prefix + "-" + id},'Synthetic office','Synthetic secretary',10000,'Synthetic',${status},${owner},${team},'2026-10-22',${status === "Completed" ? company : null}::uuid,${status === "Completed" ? "2026-10-20T00:00:00Z" : null}::timestamptz)`;
+          await tx`insert into incorporation_checklist_items(case_id,item_label,required,status) values(${id},'Synthetic CDD',true,'Missing')`;
+        }
+        await tx`insert into corporate_change_requests(id,company_id,change_type,status,owner_id,quoted_fee,new_registered_office)
+          values(${change},${company},'address_change','Requested',${owner},100,'Synthetic new office')`;
+        await tx`insert into corporate_change_checklist_items(request_id,item_label,required,status) values(${change},'Synthetic board approval',true,'Missing')`;
+        const repository = createOtherWorkReadRepository(tx as unknown as SqlClient);
+        const actor = {
+          authUserId: owner,
+          userId: owner,
+          role: "Staff" as const,
+          active: true,
+          teamId: teamA,
+        };
+        const first = await otherWorkPageForActor(
+          actor,
+          { view: "chaseToday", q: prefix, limit: 1 },
+          repository,
+          "2026-10-23",
+        );
+        expect(first.rows.map((r) => r.caseId)).toEqual([incA]);
+        expect(first.rows[0]).toMatchObject({
+          target: "/incorporation/$id",
+          daysRemaining: -1,
+          blocker: "Synthetic CDD",
+        });
+        expect(first.nextCursor).toEqual(expect.any(String));
+        const second = await otherWorkPageForActor(
+          actor,
+          { view: "chaseToday", q: prefix, limit: 1, cursor: first.nextCursor! },
+          repository,
+          "2026-10-23",
+        );
+        expect(second.rows.map((r) => r.caseId)).toEqual([change]);
+        expect(second.rows[0]).toMatchObject({
+          target: "/corporate-changes/$id",
+          dueDate: null,
+          reviewerName: null,
+          readyForApproval: false,
+        });
+        expect(second.nextCursor).toBeNull();
+        const admin = await otherWorkPageForActor(
+          { ...actor, role: "Admin" },
+          { view: "chaseToday", q: prefix },
+          repository,
+          "2026-10-23",
+        );
+        expect(admin.rows.map((r) => r.caseId).sort()).toEqual([incA, incB, change].sort());
+        expect(admin.rows.some((r) => r.caseId === closed)).toBe(false);
+        verified = true;
+        throw rollback;
+      });
+    } catch (error) {
+      if (error !== rollback) throw error;
+    }
+    expect(verified).toBe(true);
+  });
+});
