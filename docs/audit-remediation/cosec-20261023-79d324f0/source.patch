+      rows: 184,
+      nativePasses: 0,
+      releaseGate: "NO_GO",
+    });
+  });
+  it("rejects lost, duplicate or substituted original IDs", () => {
+    const lost = fixture();
+    lost.rows.pop();
+    expect(() => verify(lost)).toThrow(/184/);
