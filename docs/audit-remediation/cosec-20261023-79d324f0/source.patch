+    limit: z.number().int().min(1).max(100).optional(),
+    cursor: z.string().max(8192).optional(),
+    changeType: z.string().max(80).optional(),
+  })
+  .strict()
+  .refine((q) => !q.dueFrom || !q.dueTo || q.dueFrom <= q.dueTo, "Invalid date range.");
+export type CaseListQuery = z.infer<typeof caseListQuerySchema>;
+export type CaseListPage<T> = { items: T[]; nextCursor: string | null };
+const cursorSchema = z
+  .object({
+    v: z.literal(1),
+    scope: z.string().max(4096),
+    value: z.string().max(1000),
+    id: z.string().uuid(),
+  })
+  .strict();
+export type PreparedCaseListQuery = ReturnType<typeof prepareCaseListQuery>;
+
+export function prepareCaseListQuery(
+  actor: AuthenticatedActor,
+  domain: string,
+  input: CaseListQuery,
+) {
+  const query = caseListQuerySchema.parse(input);
+  const sort = query.sort ?? "created";
+  const limit = query.limit ?? 25;
+  const scope = JSON.stringify([
+    domain,
+    actor.authUserId,
+    actor.userId,
+    actor.role,
+    actor.teamId,
+    query.q ?? "",
+    query.status ?? null,
+    query.ownerId ?? null,
+    query.teamId ?? null,
+    query.dueFrom ?? null,
+    query.dueTo ?? null,
+    sort,
+    limit,
+    query.changeType ?? null,
+  ]);
+  let cursor: z.infer<typeof cursorSchema> | null = null;
+  if (query.cursor) {
+    try {
+      cursor = cursorSchema.parse(JSON.parse(query.cursor));
+      if (cursor.scope !== scope) throw new Error();
+    } catch {
+      throw new Error("Invalid or changed case cursor; refresh this list.");
+    }
+  }
+  return { ...query, sort, limit, scope, cursor };
+}
+
+export function finishCaseListPage<R extends { id: string; sort_value: string }, T>(
+  rows: R[],
+  query: PreparedCaseListQuery,
+  map: (row: R) => T,
+): CaseListPage<T> {
+  const page = rows.slice(0, query.limit);
+  const last = page.at(-1);
+  return {
+    items: page.map(map),
+    nextCursor:
+      rows.length > query.limit && last
+        ? JSON.stringify({ v: 1, scope: query.scope, value: last.sort_value, id: last.id })
+        : null,
+  };
+}
+
+export function caseListSearchPattern(q?: string) {
+  return q ? `%${q.replace(/[\\%_]/g, (s) => `\\${s}`)}%` : null;
+}
+
+export function caseListPath(path: "/incorporation" | "/corporate-changes", query: CaseListQuery) {
+  const params = new URLSearchParams();
+  for (const [key, value] of Object.entries(query))
+    if (value !== undefined && value !== "") params.set(key, String(value));
+  return path + (params.size ? `?${params.toString()}` : "");
+}
+export function readCaseListSearch(search: string): CaseListQuery {
+  const params = new URLSearchParams(search);
+  const raw: Record<string, unknown> = {};
+  for (const key of [
+    "q",
+    "status",
+    "ownerId",
+    "teamId",
+    "dueFrom",
+    "dueTo",
+    "sort",
+    "cursor",
+    "changeType",
+  ]) {
+    if (params.has(key)) raw[key] = params.getAll(key).length === 1 ? params.get(key) : [];
+  }
+  if (params.has("limit"))
+    raw.limit = params.getAll("limit").length === 1 ? Number(params.get("limit")) : [];
+  // Invalid URL input stays visibly recoverable rather than broadening a query.
+  const parsed = caseListQuerySchema.safeParse(raw);
+  return parsed.success ? parsed.data : { cursor: "invalid" };
+}
diff --git a/src/features/incorporation/components/case-list-controls.tsx b/src/features/incorporation/components/case-list-controls.tsx
new file mode 100644
index 0000000..8447c13
--- /dev/null
+++ b/src/features/incorporation/components/case-list-controls.tsx
@@ -0,0 +1,153 @@
+import { useRouter, useRouterState } from "@tanstack/react-router";
+import { Input, Select } from "@/components/ui/field";
+import { Button } from "@/components/ui/button";
+import { caseListPath, readCaseListSearch, type CaseListQuery } from "../case-list-query";
+
+// Shared by the two existing lists; company picker state remains in its dialog.
+// eslint-disable-next-line react-refresh/only-export-components -- Shared navigation hook for the two case lists.
+export function useCaseListView(path: "/incorporation" | "/corporate-changes") {
+  const search = useRouterState({ select: (state) => state.location.searchStr });
+  const router = useRouter();
+  const query = readCaseListSearch(search);
+  const go = (next: CaseListQuery) => {
+    void router.navigate({ href: caseListPath(path, next) });
+  };
+  return { query, returnTo: caseListPath(path, query), go };
+}
+export function CaseListControls({
+  query,
+  statuses,
+  owners,
+  go,
+  onRefresh,
+  pending,
+}: {
+  query: CaseListQuery;
+  statuses: Record<string, string>;
+  owners: { id: string; name: string }[];
+  go: (query: CaseListQuery) => void;
+  onRefresh: () => void;
+  pending: boolean;
+}) {
+  return (
+    <form
+      key={JSON.stringify(query)}
+      aria-label="案件篩選"
+      className="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"
+      onSubmit={(event) => {
+        event.preventDefault();
+        const data = new FormData(event.currentTarget);
+        const { cursor: _cursor, ...next } = query;
+        for (const key of ["q", "status", "ownerId", "dueFrom", "dueTo", "sort"] as const) {
+          const value = String(data.get(key) ?? "");
+          if (value) Object.assign(next, { [key]: value });
+          else delete next[key];
+        }
+        go(next);
+      }}
+    >
+      <label className="text-sm">
+        搜尋既有案件
+        <Input
+          name="q"
+          defaultValue={query.q ?? ""}
+          maxLength={200}
+          placeholder="公司中文或英文名稱"
+        />
+      </label>
+      <label className="text-sm">
+        狀態
+        <Select name="status" defaultValue={query.status ?? ""}>
+          <option value="">全部狀態</option>
+          {Object.entries(statuses).map(([key, label]) => (
+            <option key={key} value={key}>
+              {label}
+            </option>
+          ))}
+        </Select>
+      </label>
+      <label className="text-sm">
+        負責同事
+        <Select name="ownerId" defaultValue={query.ownerId ?? ""}>
+          <option value="">全部同事</option>
+          {owners.map((owner) => (
+            <option key={owner.id} value={owner.id}>
+              {owner.name}
+            </option>
+          ))}
+          {query.ownerId && !owners.some((owner) => owner.id === query.ownerId) ? (
+            <option value={query.ownerId}>已選同事</option>
+          ) : null}
+        </Select>
+      </label>
+      <label className="text-sm">
+        期限由
+        <Input name="dueFrom" type="date" defaultValue={query.dueFrom ?? ""} />
+      </label>
+      <label className="text-sm">
+        期限至
+        <Input name="dueTo" type="date" defaultValue={query.dueTo ?? ""} />
+      </label>
+      <label className="text-sm">
+        排序
+        <Select name="sort" defaultValue={query.sort ?? "created"}>
+          <option value="created">最新建立</option>
+          <option value="company">公司名稱</option>
+          <option value="due">最早期限</option>
+        </Select>
+      </label>
+      <div className="flex flex-wrap gap-2">
+        <Button type="submit" disabled={pending}>
+          搜尋案件
+        </Button>
+        <Button onClick={() => go({})}>清除篩選</Button>
+        <Button
+          disabled={pending}
+          onClick={() => {
+            if (query.cursor) {
+              const { cursor: _cursor, ...rest } = query;
+              go(rest);
+            } else {
+              onRefresh();
+            }
+          }}
+        >
+          重新整理列表
+        </Button>
+      </div>
+    </form>
+  );
+}
+export function CaseListPagination({
+  query,
+  nextCursor,
+  go,
+  pending,
+}: {
+  query: CaseListQuery;
+  nextCursor: string | null;
+  go: (query: CaseListQuery) => void;
+  pending: boolean;
+}) {
+  return (
+    <nav aria-label="案件分頁" className="flex items-center gap-3">
+      <Button
+        disabled={!query.cursor || pending}
+        onClick={() => {
+          const { cursor: _cursor, ...rest } = query;
+          go(rest);
+        }}
+      >
+        回到第一頁
+      </Button>
+      <Button
+        disabled={!nextCursor || pending}
+        onClick={() => {
+          if (nextCursor) go({ ...query, cursor: nextCursor });
+        }}
+      >
+        下一頁
+      </Button>
+    </nav>
+  );
+}
