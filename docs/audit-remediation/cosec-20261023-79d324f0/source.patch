@@ -0,0 +1,66 @@
+import { defaultParseSearch } from "@tanstack/react-router";
+import { expect, it } from "vitest";
+import {
+  clientRegisterSearch,
+  clientRegisterReturnPath,
+  clientDetailSearch,
+} from "./register-view-state";
+const id = "11111111-1111-4111-8111-111111111111";
+it("round-trips JSON-shaped search strings and tuple cursors using router serialization", () => {
+  const search = clientRegisterSearch({
+    q: "12345",
+    status: "inactive",
+    team: id,
+    includeFixtures: true,
+    cursor: JSON.stringify(["中文公司", id]),
+  });
+  const path = clientRegisterReturnPath(search);
+  expect(clientRegisterSearch(defaultParseSearch(path.slice(path.indexOf("?"))))).toEqual({
+    q: "12345",
+    status: "inactive",
+    team: id,
+    includeFixtures: true,
+    cursor: '["中文公司","11111111-1111-4111-8111-111111111111"]',
+  });
+});
+it("uses narrow defaults and excludes snapshots or unknown parameters from return paths", () => {
+  const search = clientRegisterSearch({ snapshot: "synthetic-secret", token: "synthetic-token" });
+  expect(search).toEqual({ q: "", status: "all", team: "all", includeFixtures: false });
+  expect(clientRegisterReturnPath(search)).not.toMatch(/snapshot|token|secret/);
+});
+it.each([
+  { q: ["a", "b"] },
+  { q: 12 },
+  { status: ["active", "inactive"] },
+  { status: "unknown" },
+  { team: [id] },
+  { team: "invalid" },
+  { includeFixtures: [true, false] },
+  { includeFixtures: "yes" },
+  { cursor: ["a", id] },
+  { cursor: "not-json" },
+  { cursor: "[]" },
+  { cursor: JSON.stringify(["Company", "bad-id"]) },
+  { q: "x".repeat(201) },
+  { cursor: "x".repeat(2049) },
+])("rejects invalid or repeated URL fields instead of broadening the read: %s", (input) => {
+  expect(() => clientRegisterSearch(input)).toThrow();
+});
+it.each([
+  undefined,
+  null,
+  ["/clients", "//evil.example"],
+  "https://evil.example",
+  "//evil.example",
+  "/clients-other",
+  "/clients/../outside",
+  "/\\evil.example",
+  "/clients\n?x=y",
+])("uses /clients fallback for unsafe returnTo: %s", (returnTo) => {
+  expect(clientDetailSearch({ returnTo })).toEqual({ returnTo: "/clients" });
+});
+it("preserves an allowed same-site clients return path", () => {
+  expect(clientDetailSearch({ returnTo: "/clients?q=Acme&status=inactive" })).toEqual({
+    returnTo: "/clients?q=Acme&status=inactive",
+  });
+});
diff --git a/src/features/clients/register-view-state.ts b/src/features/clients/register-view-state.ts
new file mode 100644
index 0000000..8411937
--- /dev/null
+++ b/src/features/clients/register-view-state.ts
@@ -0,0 +1,44 @@
+import { defaultStringifySearch } from "@tanstack/react-router";
+import { z } from "zod";
+import { caseReturnPath } from "@/features/annual-return/daily-view-state";
+
+const clientCursor = z
+  .string()
+  .min(1)
+  .max(2048)
+  .refine((value) => {
+    try {
+      // Same company-name/UUID boundary as the existing client page read.
+      z.tuple([z.string().max(512), z.string().uuid()]).parse(JSON.parse(value));
+      return true;
+    } catch {
+      return false;
+    }
+  }, "Invalid client cursor; return to the first page.");
+const searchSchema = z.object({
+  q: z.string().max(200).default(""),
+  status: z.enum(["all", "active", "inactive"]).default("all"),
+  team: z.union([z.literal("all"), z.string().uuid()]).default("all"),
+  includeFixtures: z.preprocess(
+    (value) => (value === "true" ? true : value === "false" ? false : value),
+    z.boolean().default(false),
+  ),
+  cursor: clientCursor.optional(),
+});
+export type ClientRegisterSearch = z.infer<typeof searchSchema>;
+
+/** Invalid scalar or repeated values reject navigation instead of widening filters. */
+export function clientRegisterSearch(input: Record<string, unknown>): ClientRegisterSearch {
+  return searchSchema.parse(input);
+}
+export function clientRegisterReturnPath(search: ClientRegisterSearch): string {
+  // The router's serializer preserves JSON-shaped strings, including tuple
+  // cursors and numeric company identifiers, when its parser reads them again.
+  return `/clients${defaultStringifySearch(clientRegisterSearch(search))}`;
+}
+export function clientDetailSearch(input: Record<string, unknown>) {
+  const safe = caseReturnPath(input.returnTo);
+  return {
+    returnTo: typeof input.returnTo === "string" && safe === input.returnTo ? safe : "/clients",
+  };
+}
