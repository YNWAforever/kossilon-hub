+      view: "team",
+      q: "覆核文件",
+      workType: "document_review",
+      priority: "high",
+      status: "blocked",
+      limit: 50,
+    });
+    expect(
+      queueFiltersForActor(
+        {
+          authUserId: "auth-a",
+          userId: "20000000-0000-0000-0000-000000000001",
+          role: "Manager",
+          teamId: "10000000-0000-0000-0000-000000000001",
+          active: true,
