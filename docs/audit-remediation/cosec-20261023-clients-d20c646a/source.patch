+      for (const [i, id] of ids.users.entries())
+        await tx`insert into users(id,name,email,role,team_id,active) values(${id},${"Synthetic creator " + i},${id + "@example.test"},${i === 1 ? "Staff" : "Admin"},${ids.teams[i === 1 ? 1 : 0]},${i !== 2})`;
