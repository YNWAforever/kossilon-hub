index 0000000..62944bc
--- /dev/null
+++ b/src/features/bulk-operations/payment-export.integration.test.ts
@@ -0,0 +1,466 @@
+import { createHash, randomUUID } from "node:crypto";
+import {
+  appendFileSync,
+  closeSync,
+  openSync,
+  readFileSync,
+  realpathSync,
+  writeFileSync,
+} from "node:fs";
+import { dirname, isAbsolute, relative, resolve } from "node:path";
+import { getCurrentTest } from "@vitest/runner";
+import { describe, expect, it, onTestFinished } from "vitest";
+import type { AuthenticatedActor } from "@/features/auth/types";
+import { createSqlClient } from "@/server/db/client";
+import { guardSqlTestLifetime } from "@/test/sql-test-lifetime";
+import { createAnnualReturnRepository } from "@/features/annual-return/repository";
+import { createDocumentRepository } from "@/features/documents/repository";
+import { createPaymentEvidenceService } from "@/features/annual-return/payment-evidence";
+import { createBulkOperationsRepository } from "./repository";
+import { exportBulkResultsForActor } from "./server-fns";
+import { runBulkAssignmentChunk } from "./worker";
+
+const url = process.env.TEST_DATABASE_URL,
+  run = process.env.KOSSILON_PAYMENT_EXPORT_RUN_ID;
+const directory = process.env.KOSSILON_PAYMENT_EXPORT_EVENTS_DIR,
+  attempt = process.env.KOSSILON_PAYMENT_EXPORT_ATTEMPT;
+function errorFacts(error: unknown) {
+  const e = error as { message?: string; statusCode?: number } | undefined;
+  return { message: e?.message, statusCode: e?.statusCode };
+}
+function csvRows(text: string) {
+  const rows: string[][] = [];
+  let row: string[] = [],
+    cell = "",
+    quoted = false;
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i];
+    if (c === '"') {
+      if (quoted && text[i + 1] === '"') {
+        cell += '"';
+        i++;
+      } else quoted = !quoted;
+    } else if (c === "," && !quoted) {
+      row.push(cell);
+      cell = "";
+    } else if (c === "\n" && !quoted) {
+      row.push(cell);
+      rows.push(row);
+      row = [];
+      cell = "";
+    } else cell += c;
+  }
+  expect(quoted).toBe(false);
+  expect(row).toEqual([]);
+  return rows;
+}
+describe.skipIf(!url || !run)("UC157 actual saved payment export, scope and reread", () => {
+  it("previews 103 current payments, exports two pages, redacts lost scope, rejects changing progress and resumes after cancellation", async () => {
+    if (
+      !url ||
+      !run ||
+      !/^cosec-20261024-export-[a-f0-9]{8}$/.test(run) ||
+      !directory ||
+      !attempt ||
+      !/^[a-z0-9-]+$/.test(attempt) ||
+      !/^[a-f0-9]{64}$/.test(process.env.KOSSILON_PAYMENT_EXPORT_TARGET_ID ?? "")
+    )
+      throw Error("Fresh verified UC157 target required");
+    const target = new URL(url);
+    expect(target.hostname).toBe("127.0.0.1");
+    expect(target.pathname).toBe("/" + process.env.KOSSILON_PAYMENT_EXPORT_DB_NAME);
+    const folder = resolve(directory),
+      local = relative(resolve("docs/audit-remediation", run), folder);
+    if (
+      isAbsolute(local) ||
+      local.startsWith("..") ||
+      realpathSync(folder) !== folder ||
+      realpathSync(dirname(folder)) !== dirname(folder)
+    )
+      throw Error("Redirected artifacts");
+    const context = getCurrentTest()?.context;
+    if (!context) throw Error("Test lifetime required");
+    const pending = scenario(url, run, folder, attempt, context.signal);
+    onTestFinished(async () => {
+      await pending.catch(() => undefined);
+    });
+    await pending;
+  }, 120_000);
+});
+async function scenario(
+  databaseUrl: string,
+  tag: string,
+  folder: string,
+  attemptId: string,
+  signal: AbortSignal,
+) {
+  const fd = openSync(resolve(folder, `UC157-${attemptId}.jsonl`), "wx");
+  const record = (phase: string, values: object) =>
+    appendFileSync(fd, JSON.stringify({ runId: tag, phase, ...values }) + "\n");
+  const ids = {
+    team: randomUUID(),
+    users: [randomUUID(), randomUUID()],
+    profiles: [randomUUID(), randomUUID()],
+    companies: Array.from({ length: 104 }, () => randomUUID()),
+    cases: Array.from({ length: 104 }, () => randomUUID()),
+    payments: Array.from({ length: 104 }, () => randomUUID()),
+  };
+  const actor = (index = 0): AuthenticatedActor => ({
+    userId: ids.users[index],
+    authUserId: `${tag}:${ids.users[index]}`,
+    role: "Admin",
+    teamId: ids.team,
+    active: true,
+  });
+  record("planned-ids", {
+    ids,
+    synthetic: true,
+    nativeAuth: false,
+    scanner: "local contract stub; no external provider or storage",
+  });
+  const raw = createSqlClient(databaseUrl, { ssl: false, max: 1 }),
+    readRaw = createSqlClient(databaseUrl, { ssl: false, max: 1 });
+  const sql = guardSqlTestLifetime(raw, () => signal),
+    read = guardSqlTestLifetime(readRaw, () => signal);
+  const repo = createBulkOperationsRepository({ sql }),
+    reader = createBulkOperationsRepository({ sql: read });
+  const cases = createAnnualReturnRepository({ sql }),
+    docs = createDocumentRepository({ sql }),
+    paymentService = createPaymentEvidenceService({ sql });
+  const moneySnapshot = async (phase: string) => {
+    const payments =
+      await read`select id,company_id,case_id,invoice_number,amount::text,currency,status,paid_at::text,payment_proof_document_id,updated_at::text from payments where id=any(${ids.payments}::uuid[]) order by id`;
+    const entries =
+      await read`select id,payment_id,document_id,proof_version_id,status,amount::text,reviewed_by,reviewed_at::text from payment_evidence_entries where case_id=any(${ids.cases}::uuid[]) order by id`;
+    const audits =
+      await read`select id,case_id,actor_id,action,result,metadata from annual_return_audit_events where case_id=any(${ids.cases}::uuid[]) order by id`;
+    const [outbox] =
+      await read`select count(*)::int count from notification_outbox where work_item_id in(select id from work_items where company_id=any(${ids.companies}::uuid[]))`;
+    const snapshot = {
+      payments: [...payments],
+      entries: [...entries],
+      audits: [...audits],
+      outbox: outbox.count,
+    };
+    record(phase, snapshot);
+    return snapshot;
+  };
+  const saveCsv = (name: string, csv: string) => {
+    const path = resolve(folder, `UC157-${attemptId}-${name}.csv`);
+    writeFileSync(path, csv, { flag: "wx" });
+    const bytes = readFileSync(path);
+    expect(bytes.toString()).toBe(csv);
+    record("csv-artifact", {
+      name,
+      path: relative(resolve(folder, ".."), path).replaceAll("\\", "/"),
+      sha256: createHash("sha256").update(bytes).digest("hex"),
+      bytes: bytes.length,
+    });
+    return csvRows(bytes.toString()).slice(1);
+  };
+  try {
+    await sql.begin(async (tx) => {
+      await tx`insert into teams(id,name) values(${ids.team},${tag})`;
+      for (const [i, id] of ids.users.entries()) {
+        await tx`insert into users(id,name,email,role,team_id,active) values(${id},${"Synthetic UC157 admin " + i},${id + "@example.test"},'Admin',${ids.team},true)`;
+        await tx`insert into staff_profiles(id,user_id,auth_user_id,role,team_id,active) values(${ids.profiles[i]},${id},${actor(i).authUserId},'Admin',${ids.team},true)`;
+      }
+      await tx`insert into companies ${tx(ids.companies.map((id, i) => ({ id, company_name: i === 103 ? "PRIVATE_FIXTURE_SHOULD_NOT_EXPORT" : `Synthetic UC157, "company" ${i}\nlocal`, cr_number: id, br_number: id, incorporation_date: "2020-01-01", annual_return_basis_date: "2026-01-01", registered_office: "Synthetic", company_secretary: "Synthetic", status: "active", assigned_owner_id: ids.users[0], assigned_team_id: ids.team, data_origin: i === 103 ? "fixture" : "client" })))}`;
+      await tx`insert into annual_return_cases ${tx(ids.cases.map((id, i) => ({ id, company_id: ids.companies[i], return_year: 2026, made_up_date: "2026-01-01", filing_due_date: "2026-02-12", current_status: "Payment pending", risk_level: "green", owner_id: ids.users[0] })))}`;
+      await tx`insert into payments ${tx(ids.payments.map((id, i) => ({ id, company_id: ids.companies[i], case_id: ids.cases[i], invoice_number: i === 103 ? "PRIVATE_FIXTURE_INVOICE" : `UC157-${id}`, amount: i === 103 ? 9999 : 1800, due_date: "2026-02-12" })))}`;
+    });
+    const [writerPid] = await sql<{ pid: number }[]>`select pg_backend_pid() pid`,
+      [readerPid] = await read<{ pid: number }[]>`select pg_backend_pid() pid`;
+    expect(writerPid.pid).not.toBe(readerPid.pid);
+    record("physical-sessions", { writerPid: writerPid.pid, readerPid: readerPid.pid });
+    for (const [index, amount] of [
+      [1, "350.25"],
+      [2, "1800.00"],
+    ] as const) {
+      const bytes = Buffer.from(`%PDF-1.4\n${tag}:${ids.cases[index]}\n%%EOF`),
+        checksum = createHash("sha256").update(bytes).digest("hex");
+      const intent = await docs.createUploadIntent({
+        companyId: ids.companies[index],
+        caseId: ids.cases[index],
+        requestedByAuthUserId: actor().authUserId,
+        category: "payment",
+        fileName: `local-${index}.pdf`,
+        contentType: "application/pdf",
+        expectedSizeBytes: bytes.length,
+        checksum,
+        objectKey: `${tag}/${ids.cases[index]}.pdf`,
+        expiresAt: new Date(Date.now() + 300_000).toISOString(),
+      });
+      record("intent-created", { index, intentId: intent.id, checksum, byteSize: bytes.length });
+      const document = await docs.finalizeUploadIntent({
+        intentId: intent.id,
+        uploadedBy: ids.users[0],
+        source: "staff",
+      });
+      record("document-created", { index, documentId: document.id, intentId: intent.id });
+      await docs.recordScanResult(
+        intent.id,
+        {
+          status: "clean",
+          providerReference: tag + ":local-stub",
+          verifiedChecksum: checksum,
+          verifiedByteSize: bytes.length,
+        },
+        { verdictSource: "provider" },
+      );
+      const proofVersionId = (await docs.getDocument(document.id))!.currentVersionId!;
+      const base = {
+        caseId: ids.cases[index],
+        paymentId: ids.payments[index],
+        documentId: document.id,
+        proofVersionId,
+      };
+      record("proof-version", base);
+      await paymentService.record({
+        ...base,
