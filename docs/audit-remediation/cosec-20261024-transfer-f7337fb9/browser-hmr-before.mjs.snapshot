// PREPARATION ONLY: parent owns the >=2 GiB resource gate and execution schedule.
// Parent command from exact root (not run by the preparer):
// node docs/audit-remediation/cosec-20261024-transfer-f7337fb9/run-checks.mjs browser green1
// Fresh attempts: green1/current1 or historical1/red1. Never overwrite receipts.
// Historical mode overlays ONLY exact-base UI; schema/service remain final/current.
// Run all nine cases and retain observed failures; no assumed historical failure count.
import assert from 'node:assert/strict';
import { execFileSync } from 'node:child_process';
import { createHash, randomUUID } from 'node:crypto';
import { appendFileSync, existsSync, mkdirSync, readFileSync, realpathSync, writeFileSync } from 'node:fs';
import { builtinModules } from 'node:module';
import { dirname, join, relative, resolve } from 'node:path';
import { createServer } from 'vite';
import react from '@vitejs/plugin-react';
import tailwindcss from '@tailwindcss/vite';
import { chromium, expect } from '@playwright/test';

const folder = import.meta.dirname, root = resolve(folder, '../../..'), attempt = process.argv[2];
const run = 'cosec-20261024-transfer-f7337fb9', base = 'c6c8a74be1377c57b73dd9870056441cd8e34e33';
assert.match(attempt || '', /^(?:historical|red|current|green)[0-9]+$/, 'Use a fresh numbered attempt');
assert.equal(realpathSync(process.cwd()), root);
assert.equal(realpathSync(root), 'C:\\Users\\laich\\Documents\\kossilon-hub\\cosec-20261023');
assert.equal(realpathSync(folder), join(root, 'docs/audit-remediation', run));
const normalized = path => path.replaceAll('\\', '/');
const digest = bytes => createHash('sha256').update(bytes).digest('hex');
const git = (...args) => execFileSync('git', ['--no-optional-locks', ...args],
  { cwd: root, windowsHide: true, encoding: 'utf8' }).trim();
assert.equal(normalized(git('rev-parse', '--show-toplevel')), normalized(root));
assert.equal(git('branch', '--show-current'), 'codex/cosec-20261023');
assert.equal(git('merge-base', 'HEAD', base), base);
const head = git('rev-parse', 'HEAD'), historical = /^(historical|red)/.test(attempt), instance = randomUUID();
const allowedEnv = /^(PATH|PATHEXT|SystemRoot|WINDIR|COMSPEC|TEMP|TMP|USERPROFILE|LOCALAPPDATA|APPDATA|PROGRAMFILES|PROGRAMFILES\(X86\)|PROGRAMW6432|HOMEDRIVE|HOMEPATH|NUMBER_OF_PROCESSORS|PROCESSOR_ARCHITECTURE|LOGONSERVER|SYSTEMDRIVE|USERDOMAIN|USERNAME|CI|NO_COLOR)$/i;
assert.deepEqual(Object.keys(process.env).filter(key => !allowedEnv.test(key)), [],
  'Invoke through parent sanitized run-checks; no inherited application/provider variables');
const dialogPath = 'src/components/corporate-changes/create-corporate-change-request-dialog.tsx';
const overlayName = 'create-corporate-change-request-dialog.tsx.before.snapshot';
const baseline = readFileSync(join(folder, overlayName));
assert(baseline.equals(execFileSync('git', ['show', `${base}:${dialogPath}`],
  { cwd: root, windowsHide: true })), 'UI overlay must match exact base bytes');
const sourcePaths = [dialogPath, 'src/features/corporate-changes/create.ts',
  'src/features/corporate-changes/create-input.ts', 'src/features/corporate-changes/read.ts',
  'src/features/corporate-changes/authorization.ts', 'src/features/corporate-changes/errors.ts',
  'src/features/corporate-changes/types.ts', 'src/features/corporate-changes/labels.ts',
  'src/features/clients/labels.ts', 'src/features/incorporation/authorization.ts',
  'src/features/incorporation/case-list-query.ts', 'src/features/auth/types.ts',
  'src/components/ui/button.tsx', 'src/components/ui/field.tsx', 'src/components/ui/dialog.tsx',
  'src/lib/utils.ts', 'src/styles.css', 'package.json'];
const sourceBytes = new Map(sourcePaths.map(path => [normalized(join(root, path)), readFileSync(join(root, path))]));
const sourceHashes = Object.fromEntries(sourcePaths.map(path => [path, digest(sourceBytes.get(normalized(join(root, path))))]));
const actualHashes = () => Object.fromEntries(sourcePaths.map(path => [path, digest(readFileSync(join(root, path)))]));
const effectiveHashes = { ...sourceHashes, ...(historical ? { [dialogPath]: digest(baseline) } : {}) };
const harnessNames = ['browser-transfer.mjs', 'browser-entry.tsx.snapshot', overlayName];
const harnessHashesNow = () => Object.fromEntries(harnessNames.map(path => [path, digest(readFileSync(join(folder, path)))]));
const harnessHashes = harnessHashesNow();
const entryBytes = readFileSync(join(folder, 'browser-entry.tsx.snapshot'), 'utf8');
const paths = Object.fromEntries(['target', 'checkpoints', 'results'].map(kind =>
  [kind, join(folder, `browser-${kind}-${attempt}.${kind === 'checkpoints' ? 'jsonl' : 'json'}`)]));
for (const path of Object.values(paths)) assert(!existsSync(path), `Immutable output exists: ${path}`);
// Runtime receipts/cache are written only when the parent schedules this script.
const cache = join(root, '.worktrees', `transfer-f7337fb9-browser-${attempt}`);
assert.equal(realpathSync(join(root, '.worktrees')), join(root, '.worktrees'));
assert(!existsSync(cache), 'Prior attempt cache retained; choose a fresh attempt');
mkdirSync(cache);
writeFileSync(paths.checkpoints, '', { flag: 'wx' });

const boundaryViolations = [], resolutions = [], blocked = [], pageErrors = [], consoleErrors = [], httpErrors = [];
const servedProductionModules = new Set(), loadedSourceHashes = {}, results = [];
const started = new Date().toISOString();
const deny = message => { boundaryViolations.push(message); throw Error(message); };
const rpc = {
  changes: 'export const createCorporateChangeRequest=({data})=>window.__uc166.create(data);',
  clients: 'export const getClient=({data})=>window.__uc166.getClient(data.id);',
};
const stubs = new Map([
  [normalized(join(root, 'src/features/corporate-changes/server-fns')), 'changes'],
  [normalized(join(root, 'src/features/clients/server-fns')), 'clients'],
]);
const allowedSources = new Set(sourcePaths.filter(path => path.startsWith('src/'))
  .map(path => normalized(join(root, path)).replace(/\.tsx?$/, '')));
const deniedBuiltins = new Set(builtinModules.map(name => name.replace(/^node:/, '')));
const cacheUrl = '/' + normalized(relative(root, cache)) + '/';
let origin, identity, server, browser, outerError, browserVersion;
try {
  server = await createServer({ configFile: false, envFile: false, envDir: false, root,
    cacheDir: join(cache, 'vite'), publicDir: false,
    plugins: [{ name: 'uc166-local-only-boundaries', enforce: 'pre',
      resolveId(id, importer) {
        if (id === 'virtual:uc166') return '\0uc166-entry.tsx';
        const from = normalized((importer || '').split('?')[0]), raw = id.split('?')[0];
        const absolute = normalized(raw.startsWith('@/') ? join(root, 'src', raw.slice(2)) :
          raw.startsWith('/src/') ? join(root, raw.slice(1)) :
          raw.startsWith('.') && from && !from.startsWith('\0') ? resolve(dirname(from), raw) : raw)
          .replace(/\.tsx?$/, '');
        if (stubs.has(absolute)) {
          const stub = stubs.get(absolute); resolutions.push({ id, from, stub }); return `\0uc166-${stub}`;
        }
        if (/^(https?:|wss?:|\/\/|node:)/.test(id) || deniedBuiltins.has(raw) ||
            /(?:^|\/)(?:server-fns(?:\.|\/|$)|server(?:\/|$)|repository(?:\.|\/|$)|neon-auth-server(?:\.|$))/.test(absolute) ||
            /\.server(?:\.|\/|$)/.test(absolute) || absolute.endsWith('/routes/__root') ||
            /^(?:@tanstack\/react-start|@neondatabase\/|better-auth|postgres(?:\/|$)|pg(?:\/|$)|dotenv(?:\/|$))/.test(id)) {
          return deny(`Unstubbed UC166 server/external import: ${id}`);
        }
        if (absolute.startsWith(normalized(join(root, 'src')) + '/') && !allowedSources.has(absolute)) {
          return deny(`Source outside reviewed UC166 import allowlist: ${absolute}`);
        }
      },
      load(id) {
        if (id === '\0uc166-entry.tsx') return entryBytes;
        for (const [name, code] of Object.entries(rpc)) if (id === `\0uc166-${name}`) return code;
        const path = normalized(id.split('?')[0]);
        if (sourceBytes.has(path) && /\.(tsx?|css)$/.test(path)) {
          const bytes = historical && path === normalized(join(root, dialogPath)) ? baseline : sourceBytes.get(path);
          loadedSourceHashes[normalized(relative(root, path))] = digest(bytes);
          return bytes.toString('utf8');
        }
      },
      configureServer(s) { s.middlewares.use((req, res, next) => {
        if (!['GET', 'HEAD'].includes(req.method)) {
          boundaryViolations.push(`Denied local HTTP method ${req.method}`); res.statusCode = 405; res.end(); return;
        }
        if (identity && req.headers.host !== `127.0.0.1:${identity.port}`) {
          boundaryViolations.push('Denied mismatched loopback Host'); res.statusCode = 421; res.end(); return;
        }
        const url = new URL(req.url, 'http://127.0.0.1'), pathname = url.pathname;
        if (pathname === '/__uc166_identity') {
          if (!identity) { res.statusCode = 503; res.end(); return; }
          res.setHeader('content-type', 'application/json'); res.setHeader('cache-control', 'no-store');
          res.end(JSON.stringify(identity)); return;
        }
        if (pathname === '/corporate-changes') {
          if (!identity || url.searchParams.get('run') !== run || url.searchParams.get('instance') !== instance ||
              url.searchParams.get('attempt') !== attempt || !/^[a-z0-9-]+$/.test(url.searchParams.get('case') || '')) {
            boundaryViolations.push('Denied mismatched run/instance/attempt HTML'); res.statusCode = 421; res.end(); return;
          }
          res.setHeader('content-type', 'text/html'); res.setHeader('cache-control', 'no-store');
          res.setHeader('x-uc166-run', run);
          res.setHeader('content-security-policy', "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self'; worker-src 'none'; base-uri 'none'; form-action 'none'");
          res.end('<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"><title>UC166 local stub transport</title></head><body><div id="app"></div><script>window.__UC166_EXPECTED_TARGET=' +
            JSON.stringify(identity).replaceAll('<', '\\u003c') + '</script><script type="module" src="/@id/__x00__uc166-entry.tsx"></script></body></html>'); return;
        }
        if (pathname === '/favicon.ico') { res.statusCode = 204; res.end(); return; }
        if (['/src/', '/node_modules/', '/@id/', '/@fs/', cacheUrl].some(prefix => pathname.startsWith(prefix)) ||
            ['/@vite/client', '/@react-refresh'].includes(pathname)) { next(); return; }
        boundaryViolations.push(`Denied unstubbed local HTTP path ${pathname}`);
        res.statusCode = 451; res.end('UC166 local boundary denied');
      }); },
    }, react(), tailwindcss()], resolve: { alias: { '@': join(root, 'src') } },
    server: { host: '127.0.0.1', port: 0, hmr: false, watch: null, fs: { strict: true, allow: [root] } },
    optimizeDeps: { noDiscovery: true, include: ['react', 'react-dom', 'react-dom/client', '@tanstack/react-query',
      '@tanstack/react-router', '@radix-ui/react-dialog', '@radix-ui/react-slot', 'lucide-react',
      'class-variance-authority', 'clsx', 'tailwind-merge', 'zod'] }, logLevel: 'warn' });
  await server.listen();
  const address = server.httpServer.address();
  assert(address && typeof address !== 'string'); assert.equal(address.address, '127.0.0.1');
  assert(Number.isInteger(address.port) && address.port > 0);
  origin = `http://127.0.0.1:${address.port}`;
  identity = { run_id: run, attempt, instance, root: normalized(root), origin, host: address.address,
    port: address.port, branch: 'codex/cosec-20261023', base, head, transport: 'local-memory-sessionStorage-stub' };
  const preflight = await fetch(origin + '/__uc166_identity', { redirect: 'error' });
  assert.equal(preflight.status, 200); assert.deepEqual(await preflight.json(), identity);
  const href = caseId => '/corporate-changes?' + new URLSearchParams({ run, instance, attempt, case: caseId });
  const html = await fetch(origin + href('preflight'), { redirect: 'error' });
  assert.equal(html.headers.get('x-uc166-run'), run);
  assert((await html.text()).includes('/@id/__x00__uc166-entry.tsx'));
  const edge = 'C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe'; assert(existsSync(edge));
  writeFileSync(paths.target, JSON.stringify({ ...identity, started, configFile: false, envFile: false, envDir: false,
    sourceHashes, effectiveHashes, harnessHashes, source_freeze: 'Reviewed production modules served from frozen bytes; disk/HEAD/harness checked again at end',
    historical_overlay: historical ? { path: dialogPath, source: overlayName, base,
      scope: 'UI ONLY; final shared schema and ForActor service remain active; failures observed without assumed count' } : null,
    real_layers: ['headless Edge', 'Vite loopback assets', 'actual dialog and styles', 'shared input schema',
      'createCorporateChangeRequestForActor', 'getCorporateChangeRequestForActor'],
    stubbed_layers: ['root Staff actor and authentication', 'virtual RPC transport', 'register fixtures', 'memory/sessionStorage repository'],
    native_application_http: false, native_auth: false, native_db: false, native_rls: false,
    resource_gate: 'Parent owns >=2 GiB browser resource check before invocation' }, null, 2) + '\n', { flag: 'wx' });
  browser = await chromium.launch({ executablePath: edge, headless: true,
    args: ['--disable-background-networking', '--disable-component-update', '--no-first-run',
      '--disable-sync', '--disable-default-apps', '--no-proxy-server', '--host-resolver-rules=MAP * ~NOTFOUND, EXCLUDE 127.0.0.1'] });
  browserVersion = browser.version();
  const state = page => page.evaluate(() => {
    const w = window.__uc166;
    return { identity: w.identity, ledger: w.ledger, documentId: w.documentId, queryClientId: w.queryClientId,
      boot: w.boot, pending: w.pending.length, settled: w.settled, violations: w.violations };
  });
  const submitButton = page => page.getByRole('button', { name: '建立申請', exact: true });
  const nativeValidity = field => field.evaluate(node => ({ valid: node.validity.valid,
    valueMissing: node.validity.valueMissing, rangeUnderflow: node.validity.rangeUnderflow,
    rangeOverflow: node.validity.rangeOverflow, stepMismatch: node.validity.stepMismatch }));
  // Explicit bypass: exercises React onSubmit with disabled submit/native validation bypassed.
  const bypassSubmit = (page, count = 1) => page.locator('form').evaluate((form, count) => {
    for (let i = 0; i < count; i++) form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
  }, count);
  const fieldError = async (page, id, focus = false) => {
    const field = page.locator('#' + id);
    await expect(field).toHaveAttribute('aria-invalid', 'true');
    const description = await field.getAttribute('aria-describedby'); assert(description?.trim());
    const messages = await field.evaluate(node => (node.getAttribute('aria-describedby') || '').split(/\s+/)
      .filter(Boolean).map(id => ({ id, text: document.getElementById(id)?.textContent?.trim() || '',
        exists: !!document.getElementById(id) })));
    assert(messages.every(item => item.exists)); assert(messages.some(item => /[\u3400-\u9fff]/.test(item.text)),
      'A linked, nonempty Chinese field explanation is required');
    for (const message of messages.filter(item => item.text)) await expect(page.locator('[id="' + message.id + '"]')).toBeVisible();
    if (focus) await expect(field).toBeFocused();
    return { id, description, messages, focus, nativeValidity: await nativeValidity(field) };
  };
  const noCreate = async page => {
    const s = await state(page); assert.equal(s.ledger.rpcCalls.length, 0);
    assert.equal(s.ledger.writes.length, 0); assert.equal(s.ledger.callbacks.length, 0);
    assert.equal(Object.keys(s.ledger.records).length, 0); return s;
  };
  const fillValid = async page => {
    await expect(page.getByRole('dialog')).toBeVisible();
    await page.getByLabel('公司', { exact: true }).selectOption('f7337fb9-0166-4166-8166-000000000001');
    await page.getByLabel('變更類別', { exact: true }).selectOption('share_transfer');
    await expect(page.locator('#corp-change-transferor-shareholding option').filter({ hasText: 'QA UC166 Transferor' })).toHaveCount(1);
    await page.getByLabel('報價（HKD）', { exact: true }).fill('2500');
    await page.getByLabel('轉讓人股權', { exact: true }).selectOption('f7337fb9-0166-4166-8166-000000000002');
    await page.getByLabel('新股東名稱', { exact: true }).fill('QA UC166 New Holder');
    await page.getByLabel('新股東地址', { exact: true }).fill('QA UC166 synthetic address');
    await page.getByLabel('轉讓股數', { exact: true }).fill('10');
    await page.getByLabel('代價（HKD）', { exact: true }).fill('0');
    await page.getByLabel('印花稅（HKD）', { exact: true }).fill('0');
  };
  const readback = async page => {
    await expect(page.getByTestId('readback')).not.toBeEmpty();
    const row = JSON.parse(await page.getByTestId('readback').innerText()), s = await state(page);
    assert.equal(s.ledger.callbacks.length, 1); assert.equal(s.ledger.writes.length, 1);
    assert.equal(row.id, s.ledger.callbacks[0].id); assert.equal(row.id, s.ledger.writes[0].id);
    assert.deepEqual(row, s.ledger.records[row.id]); assert.equal(s.ledger.reads.at(-1).id, row.id);
    assert.equal(s.ledger.reads.at(-1).documentId, s.documentId);
    assert.equal(s.ledger.reads.at(-1).queryClientId, s.queryClientId);
    await expect(page.getByRole('dialog')).toHaveCount(0); return { row, state: s };
  };
  const test = async (caseId, name, body) => {
    const context = await browser.newContext({ serviceWorkers: 'block', viewport: { width: 1280, height: 900 } });
    let page, ready = false, result;
    try {
      await context.route('**/*', route => {
        const request = route.request(), url = new URL(request.url());
        if (url.origin === origin && url.protocol === 'http:' && ['GET', 'HEAD'].includes(request.method())) return route.continue();
        blocked.push({ name, url: url.href, method: request.method() }); return route.abort();
      });
      await context.routeWebSocket('**/*', socket => { blocked.push({ name, websocket: true }); socket.close(); });
      page = await context.newPage(); page.setDefaultTimeout(7000);
      page.on('pageerror', error => pageErrors.push({ name, error: error.message }));
      page.on('console', message => { if (message.type() === 'error') consoleErrors.push({ name, error: message.text() }); });
      page.on('response', response => {
        if (response.status() >= 400) httpErrors.push({ name, url: response.url(), status: response.status() });
        const path = new URL(response.url()).pathname;
        if (path.startsWith('/src/') && response.ok()) servedProductionModules.add(path);
      });
      await page.goto(origin + href(caseId));
      await page.waitForFunction(() => window.__uc166?.ready === true, {}, { timeout: 30000 });
      assert.deepEqual((await state(page)).identity, identity); ready = true;
      const evidence = await body(page); assert.deepEqual((await state(page)).violations, []);
      result = { case_id: caseId, name, status: 'passed', evidence, state: await state(page) };
    } catch (error) {
      result = { case_id: caseId, name, status: ready ? 'failed' : 'setup_failed', error: error.stack || error.message,
        url: page?.url(), dom: await page?.locator('body').innerText().catch(() => null),
        state: page ? await state(page).catch(() => null) : null };
    } finally { await context.close(); }
    results.push(result); appendFileSync(paths.checkpoints, JSON.stringify(result) + '\n');
    if (result.status === 'setup_failed') throw Error(`Setup failed in ${name}; remaining cases not run`);
  };

  await test('missing-new', 'Missing and whitespace new holder: blur explanation, bypass focus, zero RPC', async page => {
    await expect(page.getByRole('dialog')).toBeVisible();
    await page.getByLabel('公司', { exact: true }).selectOption('f7337fb9-0166-4166-8166-000000000001');
    await page.getByLabel('變更類別', { exact: true }).selectOption('share_transfer');
    await expect(page.locator('#corp-change-transferor-shareholding option').filter({ hasText: 'QA UC166 Transferor' })).toHaveCount(1);
    await page.getByLabel('新股東名稱', { exact: true }).focus();
    await page.getByLabel('新股東名稱', { exact: true }).blur();
    const incomplete = await fieldError(page, 'corp-change-transferee-new-name');
    await noCreate(page);
    await fillValid(page); const evidence = [];
    for (const value of ['', '   ']) {
      const field = page.getByLabel('新股東名稱', { exact: true }); await field.fill(value); await field.blur();
      if (!value) await expect(submitButton(page)).toBeDisabled();
      const blur = await fieldError(page, 'corp-change-transferee-new-name');
      await bypassSubmit(page); const submit = await fieldError(page, 'corp-change-transferee-new-name', true);
      await noCreate(page); await expect(page.getByLabel('報價（HKD）', { exact: true })).toHaveValue('2500');
      await expect(field).toHaveValue(value); evidence.push({ value, blur, submit });
    }
    return { incomplete_numeric_draft_blur: incomplete, evidence, submit_method: 'programmatic form.dispatchEvent bypass; not a user click on disabled submit' };
  });
  await test('missing-existing', 'Missing existing holder: disabled submit still gives linked blur explanation', async page => {
    await fillValid(page); await page.getByLabel('現有股東', { exact: true }).check();
    const field = page.getByLabel('承讓人股權', { exact: true }); await field.focus(); await field.blur();
    await expect(submitButton(page)).toBeDisabled(); const blur = await fieldError(page, 'corp-change-transferee-shareholding');
    await bypassSubmit(page); const submit = await fieldError(page, 'corp-change-transferee-shareholding', true);
    await noCreate(page); return { blur, submit, submit_method: 'programmatic form.dispatchEvent bypass' };
  });
  await test('invalid-quantity', 'Quantity 0, negative, fractional and 2^31: field errors, first focus, zero RPC', async page => {
    await fillValid(page); const evidence = [];
    for (const value of ['0', '-1', '1.5', '2147483648']) {
      await page.getByLabel('轉讓股數', { exact: true }).fill(value); await bypassSubmit(page);
      evidence.push({ value, error: await fieldError(page, 'corp-change-shares-transferred', true) }); await noCreate(page);
    }
    return { evidence, submit_method: 'programmatic form.dispatchEvent bypass of native constraints/submit disabled state' };
  });
  await test('existing-control', 'Correction and new-to-existing mode: one real service create, inactive new payload null', async page => {
    await fillValid(page); await page.getByLabel('轉讓股數', { exact: true }).fill('-1'); await bypassSubmit(page);
    await fieldError(page, 'corp-change-shares-transferred', true); await noCreate(page);
    await page.getByLabel('轉讓股數', { exact: true }).fill('10');
    await page.getByLabel('現有股東', { exact: true }).check();
    await expect(page.getByLabel('新股東', { exact: true })).not.toBeChecked();
    await page.getByLabel('承讓人股權', { exact: true }).selectOption('f7337fb9-0166-4166-8166-000000000003');
    await submitButton(page).click(); const { row, state: s } = await readback(page);
    assert.equal(s.ledger.rpcCalls.length, 1); assert.equal(s.ledger.reads.length, 1);
    const input = s.ledger.rpcCalls[0].input;
    assert.equal(input.transfereeShareholdingId, 'f7337fb9-0166-4166-8166-000000000003');
    for (const key of ['transfereeNewShareholderName', 'transfereeNewShareholderAddress']) {
      assert.equal(input[key], null); assert.equal(row[key], null);
    }
    return { row, payload: input, rejected_before_correction_rpc: 0, positive_submit: 'actual enabled button click', readback: 'actual read service with injected ledger repository' };
  });
  await test('new-control-reload', 'Existing-to-new mode: trim name, max integer, onCreated readback and actual browser reload', async page => {
    await fillValid(page); await page.getByLabel('現有股東', { exact: true }).check();
    await page.getByLabel('承讓人股權', { exact: true }).selectOption('f7337fb9-0166-4166-8166-000000000003');
    await page.getByLabel('新股東', { exact: true }).check();
    await expect(page.getByLabel('現有股東', { exact: true })).not.toBeChecked();
    await page.getByLabel('新股東名稱', { exact: true }).fill('  QA UC166 New Holder  ');
    await page.getByLabel('轉讓股數', { exact: true }).fill('2147483647');
    await submitButton(page).click(); const before = await readback(page);
    assert.equal(before.state.ledger.rpcCalls.length, 1); assert.equal(before.state.ledger.reads.length, 1);
    assert.equal(before.state.ledger.rpcCalls[0].input.transfereeShareholdingId, null);
    assert.equal(before.row.transfereeShareholdingId, null); assert.equal(before.row.transfereeNewShareholderName, 'QA UC166 New Holder');
    assert.equal(before.row.sharesTransferred, 2147483647); const url = page.url();
    await page.reload(); await page.waitForFunction(() => window.__uc166?.ready === true);
    const after = await readback(page);
    assert.notEqual(after.state.documentId, before.state.documentId); assert.notEqual(after.state.queryClientId, before.state.queryClientId);
    assert.equal(after.state.boot, before.state.boot + 1); assert.equal(after.state.ledger.reads.length, 2);
    assert.equal(after.state.ledger.rpcCalls.length, 1); assert.deepEqual(after.row, before.row); assert.equal(page.url(), url);
    assert.equal(after.state.ledger.callbacks.length, 1);
    return { before, after, actual_reload: true, persistence: 'own sessionStorage ledger STUB; not DB persistence',
      new_document: true, new_query_client: true, repository_read_counts: [1, 2] };
  });
  await test('redaction-retry', 'Raw repository error redacted; draft retained and explicit retry creates exactly once', async page => {
    await fillValid(page); await page.evaluate(() => window.__uc166.failNext = 1); await submitButton(page).click();
    await expect(page.getByRole('alert')).toBeVisible(); const alert = await page.getByRole('alert').innerText();
    assert(/[\u3400-\u9fff]/.test(alert)); const body = await page.locator('body').innerText();
    for (const marker of ['UC166_RAW_ERROR_f7337fb9', 'UC166_PRIVATE_TABLE_f7337fb9', 'db.internal', 'SQL', 'token=']) assert(!body.includes(marker), `Raw error leaked: ${marker}`);
    const failure = await state(page); assert.equal(failure.ledger.rpcCalls.length, 1); assert.equal(failure.ledger.writes.length, 0);
    assert.equal(failure.ledger.callbacks.length, 0); assert.equal(Object.keys(failure.ledger.records).length, 0);
    for (const [label, value] of [['新股東名稱', 'QA UC166 New Holder'], ['新股東地址', 'QA UC166 synthetic address'],
      ['轉讓股數', '10'], ['報價（HKD）', '2500'], ['代價（HKD）', '0'], ['印花稅（HKD）', '0']]) await expect(page.getByLabel(label, { exact: true })).toHaveValue(value);
    await submitButton(page).click(); const success = await readback(page);
    assert.equal(success.state.ledger.rpcCalls.length, 2); assert.equal(success.state.ledger.repositoryAttempts.length, 2);
    assert.equal(success.state.ledger.reads.length, 1); assert.deepEqual(success.state.ledger.rpcCalls[0].input, success.state.ledger.rpcCalls[1].input);
    return { alert, failure, success, simulated_error: 'repository exception in virtual RPC, not native HTTP 503' };
  });
  await test('pending-dedup', 'Two synchronous pending submit events share one RPC and one ledger create', async page => {
    await fillValid(page); await page.evaluate(() => window.__uc166.hold = true); await bypassSubmit(page, 2);
    await page.waitForFunction(() => window.__uc166.pending.length >= 1);
    const pending = await state(page); assert.equal(pending.pending, 1); assert.equal(pending.ledger.rpcCalls.length, 1);
    assert.equal(pending.ledger.writes.length, 0); assert.equal(pending.ledger.callbacks.length, 0);
    await expect(page.getByRole('button', { name: '建立中…', exact: true })).toBeDisabled();
    await expect(page.getByRole('button', { name: '取消', exact: true })).toBeDisabled();
    await page.evaluate(() => window.__uc166.release()); const success = await readback(page);
    assert.equal(success.state.ledger.rpcCalls.length, 1); assert.equal(success.state.ledger.reads.length, 1);
    return { pending, success, submit_method: 'two synchronous programmatic submit events; intentional disabled/native-validation bypass' };
  });
  await test('cancel', 'Cancel a filled valid draft without RPC, callback or ledger write', async page => {
    await fillValid(page); await page.getByRole('button', { name: '取消', exact: true }).click();
    await expect(page.getByRole('dialog')).toHaveCount(0); await noCreate(page);
    return { rpc: 0, callbacks: 0, writes: 0, records: 0 };
  });
  await test('dual-service', 'Direct actual ForActor service rejects dual transferees at both fields with no ledger write', async page => {
    const before = await noCreate(page), probe = await page.evaluate(() => window.__uc166.probeDual());
    assert.equal(probe.rejected, true); assert.equal(probe.name, 'ZodError');
    const fields = probe.issues.map(issue => issue.path[0]);
    assert(fields.includes('transfereeShareholdingId')); assert(fields.includes('transfereeNewShareholderName'));
    const after = await noCreate(page); assert.deepEqual(after.ledger, before.ledger);
    assert.equal(after.ledger.repositoryAttempts.length, 0); assert.equal(after.ledger.teamReads.length, 0);
    return { probe, zero_repository_calls: true, layer: 'direct domain service + injected repository; not UI/native RPC/DB' };
  });

  for (const stub of ['changes', 'clients']) assert(resolutions.some(item => item.stub === stub));
  for (const path of [dialogPath, 'src/features/corporate-changes/create-input.ts',
    'src/features/corporate-changes/create.ts', 'src/features/corporate-changes/read.ts']) {
    assert(servedProductionModules.has('/' + path), `Actual module was not served: ${path}`);
    assert.equal(loadedSourceHashes[path], effectiveHashes[path], `Effective source hash mismatch: ${path}`);
  }
  assert.equal(results.length, 9); assert.deepEqual(blocked, []); assert.deepEqual(boundaryViolations, []);
  assert.deepEqual(pageErrors, []); assert.deepEqual(consoleErrors, []); assert.deepEqual(httpErrors, []);
} catch (error) { outerError = error.stack || error.message; process.exitCode = 1; }
finally {
  await browser?.close().catch(error => { outerError ||= `Browser cleanup: ${error.message}`; });
  await server?.close().catch(error => { outerError ||= `Vite cleanup: ${error.message}`; });
  let freezeError;
  try {
    assert.deepEqual(actualHashes(), sourceHashes, 'Production files changed during browser attempt');
    assert.deepEqual(harnessHashesNow(), harnessHashes, 'Harness changed during browser attempt');
    assert.equal(git('rev-parse', 'HEAD'), head, 'HEAD changed during browser attempt');
    assert.equal(git('branch', '--show-current'), 'codex/cosec-20261023');
  } catch (error) { freezeError = error.stack || error.message; outerError ||= freezeError; }
  writeFileSync(paths.results, JSON.stringify({ run_id: run, attempt, instance, started, finished: new Date().toISOString(),
    root, origin, head, base, sourceHashes, effectiveHashes, harnessHashes, loadedSourceHashes,
    historical_overlay: historical ? { scope: 'UI ONLY, final schema/service', base, observed_failure_count: results.filter(r => r.status === 'failed').length } : null,
    browser_version: browserVersion, results, blocked_external_requests: blocked, unstubbed_boundary_violations: boundaryViolations,
    page_errors: pageErrors, console_errors: consoleErrors, http_errors: httpErrors, resolutions,
    served_production_modules: [...servedProductionModules].sort(), freeze_error: freezeError || null,
    outer_error: outerError || null, native_application_http: false, native_auth: false, native_db: false, native_rls: false,
    limitations: ['Synthetic Staff root context does not prove real authentication or role resolution',
      'Virtual RPC calls actual domain services with an injected local ledger; native application HTTP is blocked',
      'Register is synthetic; ledger is not SQL and proves no database constraints, atomic children, RLS or backend persistence',
      'onCreated and actual reload read through the real read service into own sessionStorage ledger only',
      'Programmatic submit cases explicitly bypass native validity/disabled UI; positive controls click enabled submit',
      'Historical overlay changes only exact-base dialog bytes; current shared schema and services stay active',
      'Headless local Edge only; no physical device or Safari/WebKit acceptance'],
    cleanup: 'Own contexts/browser/loopback server closed; immutable receipts and own cache retained; no DB/shared-resource cleanup' }, null, 2) + '\n', { flag: 'wx' });
}
const summary = { attempt, passed: results.filter(r => r.status === 'passed').length,
  failed: results.filter(r => r.status === 'failed').length, setup_failed: results.filter(r => r.status === 'setup_failed').length,
  historical_overlay: historical, outer_error: outerError || null };
console.log(JSON.stringify(summary));
if (results.some(result => result.status !== 'passed') || outerError) process.exitCode = 1;
