import assert from 'node:assert/strict';
import {execFileSync} from 'node:child_process';
import {readFileSync,readdirSync,statSync,writeFileSync} from 'node:fs';
import {join,relative,resolve} from 'node:path';
import {digest,verifyBlobs} from './git-blob-verify.mjs';
const folder=import.meta.dirname,root=resolve(folder,'../../..'),base='71dd6d003ffbcefc98e32eb8845e58c2c6eb217d';assert.equal(process.cwd(),root);
const json=name=>JSON.parse(readFileSync(join(folder,name),'utf8').replace(/^\uFEFF/,''));
const write=(name,value)=>writeFileSync(join(folder,name),JSON.stringify(value,null,2)+'\n',{flag:'wx'});
const git=(...args)=>execFileSync('git',args,{cwd:root,windowsHide:true});
const sha=git('rev-parse','HEAD').toString().trim();assert.equal(git('rev-parse','HEAD^').toString().trim(),base);
const paths=git('diff','--name-only',base,sha).toString().trim().split(/\r?\n/).sort();
const expected=['src/features/documents/repository.ts','src/features/documents/server-fns.ts','src/features/documents/upload-resume.ts','src/features/documents/upload-resume.test.ts','src/features/documents/upload-resume.integration.test.ts','src/features/documents/upload-retry.test.ts','src/routes/portal.tsx','src/routes/-upload-resume.interaction.test.tsx','src/test/db-integration-files.ts'].sort();assert.deepEqual(paths,expected);
const freeze=json('source-final-verified.json');assert.equal(freeze.files.length,648);assert.deepEqual(json('source-post-checks.json').files,freeze.files);verifyBlobs(root,sha,freeze.files);
assert(readFileSync(join(folder,'server-fns-before.ts.snapshot')).equals(git('show',base+':src/features/documents/server-fns.ts')));
write('source-candidate.json',{source_sha:sha,parent_sha:base,tested_head:freeze.head,paths,files:freeze.files.filter(row=>paths.includes(row.path)),source_freeze:'source-final-verified.json',source_files_verified:648,all_final_checked_source_bytes_equal_committed:true,production_changes:paths.filter(p=>!p.includes('.test.')&&!p.includes('.integration.')&&!p.startsWith('src/test/'))});
const checks={};
for(const [kind,attempt] of [['targeted','review-green'],['unit','verified'],['typecheck','review'],['lint','final'],['build','final'],['browser','green3'],['db','green2']]){
  const stem=kind==='db'?'db/db-upload-'+attempt:kind+'-'+attempt,r=json(stem+'.json');assert.equal(r.exit_code,0);assert.equal(r.error,null);checks[kind]={receipt:stem+'.json',log:stem+'.txt',exit_code:0};
  if(['targeted','unit','db'].includes(kind)){
    const log=readFileSync(join(folder,stem+'.txt'),'utf8'),t=log.match(/\n\s*Tests\s+(\d+) passed \((\d+)\)/),f=log.match(/\n\s*Test Files\s+(\d+) passed \((\d+)\)/);assert(t&&f);assert.equal(t[1],t[2]);assert.equal(f[1],f[2]);checks[kind].summary={tests:Number(t[1]),files:Number(f[1])};
  }
}
assert.deepEqual(checks.targeted.summary,{tests:138,files:12});assert.deepEqual(checks.unit.summary,{tests:2685,files:278});assert.deepEqual(checks.db.summary,{tests:1,files:1});
const units=json('unit-verified.json');assert.equal(units.all_source_hashes_verified,true);assert.equal(units.summary.shards,24);checks.unit.execution=units.execution;checks.unit.shards=24;
const review=json('independent-review.json'),resolution=json('review-resolution.json');assert.equal(review.findings.length,2);assert.equal(resolution.remaining,0);assert.equal(resolution.reproduced_failures,2);
for(const row of resolution.source_files)assert.equal(digest(readFileSync(join(root,row.path))),row.sha256);
const browser=json('browser-results-green3.json');assert.equal(browser.results.length,9);assert(browser.results.every(r=>r.status==='passed'));assert.equal(browser.outer_error,null);
for(const k of ['blocked_external_origins','page_errors','console_errors','http_errors'])assert.deepEqual(browser[k],[]);
for(const [p,hash] of Object.entries(browser.sourceHashes))assert.equal(digest(readFileSync(join(root,p))),hash);
checks.browser.report='browser-results-green3.json';checks.browser.passed=9;
const phases=readFileSync(join(folder,'db/sidecar-UC150-SQL-green2.jsonl'),'utf8').trim().split(/\r?\n/).map(JSON.parse);
assert(phases.some(r=>r.phase==='assertions-complete'&&r.assertionsPassed));assert(phases.some(r=>r.phase==='cleanup-readback'&&Object.values(r.remaining).every(n=>n===0)));
const cleanup=json('db/db-cleanup.json');assert(cleanup.container_absent_after&&cleanup.credentials_removed);assert(Object.values(cleanup.own_row_counts_before_removal).every(n=>n===0));
assert.deepEqual(json('local-process-inspection-after-checks.json').matching_processes,[]);
const remote=json('remote-after-checks.json');assert.equal(remote.main_sha,'1c57a67213af72bff8d776694e6ed8c986b921db');
write('release-candidate.json',{run_id:'cosec-20261024-upload-98d2f4c9',repo:'https://github.com/YNWAforever/kossilon-hub.git',root,branch:'codex/cosec-20261023',source_sha:sha,parent_sha:base,main_sha:remote.main_sha,production_sha_user_supplied_historical:'aa5d3cbddd895bca953b6eef7266ae1cc0b46215',phase:'LOCAL_UC150_PARTIAL_SCOPED_NATIVE_BLOCKED',release_gate:'NO_GO',deployed:false,auth_runtime_verified:false,native_http_db_verified:false,native_matrix:{BLOCKED:70,NOT_RUN:114,PASS:0},source_manifest:'source-candidate.json',evidence_manifest:'evidence-manifest.json',checks,local_browser:{version:browser.browser_version,passed:9,transport:'sessionStorage/memory RPC stub'},isolated_sql:{container_id:cleanup.container_id,system_id:'7700077617266991143',removed:true,storage:'byte-holding memory stub',auth:'injected adapter + real SQL membership',scanner_calls:0},remaining:['native Auth/HTTP/DB-RLS/R2/scanner/persisted reload','byte-offset/multipart resume','cross-device or journal-lost automatic recovery','independent new-request/global hash dedupe not provided','simultaneous first PUT may repeat identical bytes'],rollback:{action:'ordinary new commit reverting '+sha+'; preserve original evidence/history',production_action:false}});
const output=join(root,'.output'),walk=dir=>readdirSync(dir).flatMap(n=>{const p=join(dir,n);return statSync(p).isDirectory()?walk(p):[p]});
write('build-artifacts.json',{root:output,files:walk(output).sort().map(p=>{const b=readFileSync(p);return{path:relative(output,p).replaceAll('\\','/'),bytes:b.length,sha256:digest(b)}})});
console.log(JSON.stringify({source_sha:sha,checks,verified_source_files:648,native_pass:0}));
