  "watch_probe_source": "import path from \"node:path\";\nimport { createServer } from \"vite\";\n\nconst root = process.cwd();\nconst started = performance.now();\nconsole.log(JSON.stringify({ phase: \"create-server\", elapsedMs: 0 }));\nconst server = await createServer({ server: { host: \"127.0.0.1\", port: 0, strictPort: true } });\nfunction counts() {\n  const dirs = Object.keys(server.watcher.getWatched());\n  const prefix = path.join(root, \".worktrees\").replaceAll(\"\\\\\", \"/\") + \"/\";\n  return { directories: dirs.length, nestedWorktreeDirectories: dirs.filter((dir) => dir.replaceAll(\"\\\\\", \"/\").startsWith(prefix)).length };\n}\nconsole.log(JSON.stringify({ phase: \"created\", elapsedMs: performance.now() - started, ...counts(), ignored: server.config.server.watch?.ignored ?? null }));\nawait server.listen();\nconsole.log(JSON.stringify({ phase: \"listening\", elapsedMs: performance.now() - started, ...counts() }));\nserver.watcher.on(\"ready\", () => console.log(JSON.stringify({ phase: \"watch-ready\", elapsedMs: performance.now() - started, ...counts() })));\nsetInterval(() => console.log(JSON.stringify({ phase: \"watch-sample\", elapsedMs: performance.now() - started, ...counts() })), 1000);\n",
